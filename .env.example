# =============================================================================
# SMGNews Docker Compose Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# =============================================================================

# --- Frontend ---
# The WordPress REST API endpoint. Used server-side to fetch content from WP.
# The default uses Docker internal networking (works inside docker-compose).
NEXT_PUBLIC_WP_REST_ENDPOINT=http://wordpress:80/wp-json/wp/v2

# OpenWeatherMap API key for the weather widget
OPENWEATHERMAP_API_KEY=your-openweathermap-api-key

# --- Databases ---
# The PostgreSQL connection string is constructed automatically from
# POSTGRES_PASSWORD (see below). To use a different database (e.g. an
# external host or another user), set DATABASE_URL yourself.
# DATABASE_URL=postgres://<user>:<password>@<host>:<port>/<database>

# Avoid URL-special characters (@ : / ? #) or percent-encode them (e.g. @ -> %40).
POSTGRES_PASSWORD=changeme

# MySQL is used by WordPress
MYSQL_USER=wp
MYSQL_PASSWORD=wpsecret
MYSQL_ROOT_PASSWORD=rootsecret

# --- WordPress users ---
# WP_COMMENTS_USERNAME=comments        # auto-created user for frontend API calls
# WP_COMMENTS_EMAIL=comments@local.host
# WP_ADMIN_USER=admin                  # wp-admin account, created on first start
# WP_ADMIN_EMAIL=admin@local.host
WP_ADMIN_PASSWORD=changeme-admin

# --- WordPress ---
# The public URL of WordPress. 
# The localhost default is fine for local development; set it to your
# public WordPress domain (e.g. https://wp.news.example.com) in production.
WP_HOME=http://localhost:8080

# Internal URL of the Next.js API.
POLL_MANAGER_API_ROOT=http://web:3000/api

# The public URL of the Next.js frontend. Used by the WordPress redirect theme.
FRONTEND_URL=http://localhost:3000

# --- Ports ---
# Defaults to 3000 for web and 8080 for WordPress if unset.
# WEB_PORT=3000
# WP_PORT=8080
